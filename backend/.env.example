PORT=5000

# --- Supabase (required: auth + persistence) --------------------------
# From your Supabase project settings -> API.
SUPABASE_URL=
# Service-role (secret) key. Server-only. Bypasses row-level security, so
# never send this to the browser or commit a real value here.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider (all OPTIONAL) --------------------------------------------
# Leave BOTH keys below empty and the assistant runs on deterministic,
# rule-based logic only. No external API calls are made, so there is
# ZERO risk of billing or "insufficient credit" errors. This already
# satisfies the assignment (a working chat + availability flow).
#
# Want a real LLM without paying anything? Two free options (checked in
# this order — Groq first, then Gemini):
#
# Option A: Groq free tier (no credit card needed): https://console.groq.com
# GROQ_API_KEY=your_groq_key_here
# GROQ_MODEL=llama-3.1-8b-instant
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Option B: Google Gemini free tier (https://aistudio.google.com/apikey)
# GEMINI_API_KEY=your_gemini_key_here
# GEMINI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Only set this if you have a funded/paid OpenAI account and want to use it
# instead of Groq. Not required.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

FRONTEND_ORIGIN=http://localhost:5173
